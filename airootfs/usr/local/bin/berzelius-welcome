#!/bin/bash
# BerzeliusOS Welcome & Chemical Laboratory Navigator
# Dedicated to Jöns Jacob Berzelius (1779-1848)

CYAN='\033[1;36m'
BLUE='\033[0;34m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
MAGENTA='\033[1;35m'
WHITE='\033[1;37m'
NC='\033[0m'

clear
echo -e "${CYAN}"
cat << "EOF"
       .---.
      /     \       ____                     _ _             ___  ____  
     |  ___  |     | __ )  ___ _ __ _______| (_)_   _ ___  / _ \/ ___| 
    /| (   ) |\    |  _ \ / _ \ '__|_  / _ \ | | | | / __| | | | \___ \ 
   / |  \_/  | \   | |_) |  __/ |   / /  __/ | | |_| \__ \ | |_| |___) |
  |  |_______|  |  |____/ \___|_|  /___\___|_|_|\__,_|___/  \___/|____/ 
  |  | 400ml |  |
  |  |       |  |  Tall-Form Borosilicate Edition • Arch Linux Rolling
  |  |-300- -|  |  "In scientific inquiry, precise glassware yields pure truths."
  |  |~ ~ ~ ~|  |
  |  |~200~ ~|  |  [ Chemistry Suite • Borosilicate Glass Theme • Live Session ]
  |  |~ ~ ~ ~|  |
  |  |~100~ ~|  |
  |  \_______/  |
   \___________/
EOF
echo -e "${NC}"

show_menu() {
    echo -e "${WHITE}Welcome to BerzeliusOS! Select an option:${NC}"
    echo -e "  ${YELLOW}1)${NC} ${CYAN}Launch Installer${NC} (archinstall - install to NVMe/SSD/disk)"
    echo -e "  ${YELLOW}2)${NC} ${CYAN}Chemical Calculator${NC} (berzelius-calc - stoichiometry & molar mass)"
    echo -e "  ${YELLOW}3)${NC} ${CYAN}Periodic Table of Elements${NC} (periodic / kalzium)"
    echo -e "  ${YELLOW}4)${NC} ${CYAN}System Information & Reagents${NC} (fastfetch)"
    echo -e "  ${YELLOW}5)${NC} ${CYAN}About the Berzelius Beaker & History${NC}"
    echo -e "  ${YELLOW}6)${NC} ${CYAN}Launch Web Browser${NC} (firefox)"
    echo -e "  ${YELLOW}7)${NC} ${CYAN}Exit to Shell${NC}"
    echo ""
}

about_berzelius() {
    echo -e "${MAGENTA}========================================================================${NC}"
    echo -e "${WHITE}🧪 JÖNS JACOB BERZELIUS & THE TALL-FORM BEAKER${NC}"
    echo -e "${MAGENTA}========================================================================${NC}"
    echo -e "Jöns Jacob Berzelius (1779–1848) was a Swedish chemist and one of the"
    echo -e "foundational fathers of modern chemistry."
    echo -e ""
    echo -e "${CYAN}Key Scientific Contributions:${NC}"
    echo -e "  • ${WHITE}Modern Chemical Notation:${NC} Berzelius replaced archaic alchemical"
    echo -e "    symbols with Latin letters and numbers (e.g. H2O, CO2, Fe, Cu)."
    echo -e "  • ${WHITE}Elemental Discoveries:${NC} Discovered Cerium (Ce, 1803), Selenium (Se, 1817),"
    echo -e "    Silicon (Si, 1824), and Thorium (Th, 1829). First to isolate Zirconium (Zr)."
    echo -e "  • ${WHITE}Fundamental Concepts:${NC} Coined the terms 'catalysis', 'isomerism',"
    echo -e "    'allotrope', and 'polymer'."
    echo ""
    echo -e "${CYAN}The Berzelius Beaker (Tall-Form):${NC}"
    echo -e "  Laboratory beakers come primarily in two standardized geometries:"
    echo -e "  1. ${YELLOW}Griffin Beakers:${NC} Low-form, height is ~1.4× diameter."
    echo -e "  2. ${GREEN}Berzelius Beakers:${NC} Tall-form, height is ~2.0× diameter."
    echo -e "     Designed specifically with slender, tall walls to minimize surface area,"
    echo -e "     prevent splash during titrations, optimize heating, and provide high precision."
    echo ""
    echo -e "BerzeliusOS honors this commitment to laboratory rigor and precision by"
    echo -e "delivering a reliable, rolling Arch Linux base for scientific discovery."
    echo -e "${MAGENTA}========================================================================${NC}"
    echo ""
    read -p "Press Enter to return to menu..."
}

while true; do
    show_menu
    read -p "Select [1-7]: " choice
    case "$choice" in
        1)
            echo -e "${GREEN}Starting guided installation...${NC}"
            if command -v archinstall >/dev/null 2>&1; then
                sudo archinstall
                status=$?
                if [ $status -ne 0 ]; then
                    echo -e "${YELLOW}Installer exited with status: $status${NC}"
                fi
            else
                echo -e "${YELLOW}Archinstall command not found.${NC}"
            fi
            echo ""
            read -p "Press Enter to return to menu..."
            ;;
        2)
            if command -v berzelius-calc >/dev/null 2>&1; then
                berzelius-calc
            elif [ -x "/usr/local/bin/berzelius-calc" ]; then
                /usr/local/bin/berzelius-calc
            else
                python3 /usr/local/bin/berzelius-calc
            fi
            ;;
        3)
            if [ -n "$DISPLAY" ] && command -v kalzium >/dev/null 2>&1; then
                kalzium &
            else
                if command -v periodic >/dev/null 2>&1; then
                    periodic
                else
                    /usr/local/bin/periodic
                fi
            fi
            echo ""
            read -p "Press Enter to continue..."
            ;;
        4)
            if command -v fastfetch >/dev/null 2>&1; then
                fastfetch -c /etc/fastfetch/config.jsonc
            fi
            echo ""
            read -p "Press Enter to continue..."
            ;;
        5)
            about_berzelius
            ;;
        6)
            if [ -n "$DISPLAY" ]; then
                firefox &
            else
                echo "Running in console mode without display server."
            fi
            ;;
        7|q|Q)
            echo -e "${GREEN}Dropping into interactive shell...${NC}"
            echo -e "Type 'berzelius-welcome' anytime to return to this menu."
            exec /bin/bash
            ;;
        *)
            echo -e "${YELLOW}Invalid option.${NC}"
            ;;
    esac
    clear
done
