def show_grid():
    print("\033[1;36m" + "=" * 78)
    print(" 🧪 BerzeliusOS - Periodic System of the Elements")
    print(" ★ = Discovered or Isolated by Jöns Jacob Berzelius")
    print("=" * 78 + "\033[0m\n")
    print("  \033[1;37m1  H                                                                   He\033[0m")
    print("  \033[1;37m2  Li Be                                           B   C   N   O   F  Ne\033[0m")
    print("  \033[1;37m3  Na Mg                                          Al  \033[1;35mSi★\033[1;37m P   S  Cl  Ar\033[0m")
    print("  \033[1;37m4  K  Ca Sc Ti  V  Cr Mn Fe Co Ni Cu Zn Ga Ge As  \033[1;35mSe★\033[1;37m Br Kr\033[0m")
    print("  \033[1;37m5  Rb Sr  Y \033[1;35mZr★\033[1;37mNb Mo Tc Ru Rh Pd Ag Cd In Sn Sb Te  I  Xe\033[0m")
    print("  \033[1;37m6  Cs Ba La Hf Ta  W Re Os Ir Pt Au Hg Tl Pb Bi Po At Rn\033[0m")
    print("  \033[1;37m7  Fr Ra Ac Rf Db Sg Bh Hs Mt Ds Rg Cn Nh Fl Mc Lv Ts Og\033[0m")
    print("\n      \033[1;35mCe★\033[1;37m Pr Nd Pm Sm Eu Gd Tb Dy Ho Er Tm Yb Lu (Lanthanides)")
    print("      \033[1;35mTh★\033[1;37m Pa  U Np Pu Am Cm Bk Cf Es Fm Md No Lr (Actinides)\033[0m\n")
    print("Type \033[1;33mperiodic <symbol>\033[0m (e.g. periodic Si) or \033[1;33mkalzium\033[0m for full GUI.")

def show_element(symbol):
    match = None
    for item in ELEMENT_DATA:
        if item[1].lower() == symbol.lower() or str(item[0]) == symbol:
            match = item
            break
    if not match:
        print(f"Element '{symbol}' not found in quick table. Launch 'kalzium' for full 118-element database.")
        return
    z, sym, name, mass, group_name, period, group, discoverer = match
    print("\033[1;36m" + "-" * 56 + "\033[0m")
    print(f"  \033[1;33m[{z}] {name} ({sym})\033[0m")
    print("\033[1;36m" + "-" * 56 + "\033[0m")
    print(f"  Standard Atomic Weight: \033[1;32m{mass} u\033[0m")
    print(f"  Chemical Series:        {group_name}")
    print(f"  Period: {period}, Group: {group}")
    if "★" in discoverer:
        print(f"  Discovered by:          \033[1;35m{discoverer}\033[0m")
    else:
        print(f"  Discovered by:          {discoverer}")
    print("\033[1;36m" + "-" * 56 + "\033[0m\n")

if __name__ == "__main__":
    if len(sys.argv) > 1:
        show_element(sys.argv[1])
    else:
        show_grid()
