#!/usr/bin/env bash
#
# berzelius-update: Update BerzeliusOS system components, tools, branding & packages from GitHub
#

set -e

CYAN='\033[1;36m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
NC='\033[0m' # No Color

# Ensure root
if [ "$EUID" -ne 0 ]; then
    echo -e "${YELLOW}Notice: berzelius-update needs root privileges. Elevating with sudo...${NC}"
    exec sudo "$0" "$@"
fi

echo -e "${CYAN}"
echo "    .---.      ____                      _ _             ___  ____  "
echo "   /     \    | __ )  ___ _ __ _______ / (_)_   _ ___  / _ \/ ___| "
echo "  |  ___  |   |  _ \ / _ \ '__|_  / _ \ | | | | | / __| | | |\___ \ "
echo " /| (   ) |\  | |_) |  __/ |   / /  __/ | | | |_| \__ \ |_| |___) |"
echo "/ |  \_/  | \ |____/ \___|_|  /___\___|_|_|_|\__,_|___/\___/|____/ "
echo "| |_______| |"
echo "| | 400ml | |      🧪 System & Laboratory Components Updater       "
echo "\___________/"
echo -e "${NC}"

UPDATE_PACKAGES=true
if [ "$1" == "--config-only" ] || [ "$1" == "--skip-packages" ]; then
    UPDATE_PACKAGES=false
fi

# Step 1: Fetching latest BerzeliusOS components from GitHub
echo -e "${CYAN}[1/3] Fetching latest BerzeliusOS files from GitHub...${NC}"
TMP_DIR=$(mktemp -d /tmp/berzelius-update-XXXXXX)

cleanup() {
    rm -rf "$TMP_DIR"
}
trap cleanup EXIT

ARCHIVE_URL="https://github.com/rappar222/berzelius-os/archive/refs/heads/main.tar.gz"

if ! curl -sL "$ARCHIVE_URL" | tar -xz -C "$TMP_DIR"; then
    echo -e "${RED}Error: Failed to download updates from GitHub repository.${NC}"
    echo "Check your internet connection."
    exit 1
fi

SRC_ROOT="$TMP_DIR/berzelius-os-main"

if [ ! -d "$SRC_ROOT" ]; then
    echo -e "${RED}Error: Unexpected archive structure.${NC}"
    exit 1
fi

# Step 2: Installing updated components & branding
echo -e "${CYAN}[2/3] Updating BerzeliusOS binaries, glassware tools & branding...${NC}"

# A. Binaries in /usr/local/bin
if [ -d "$SRC_ROOT/airootfs/usr/local/bin" ]; then
    mkdir -p /usr/local/bin
    cp -af "$SRC_ROOT/airootfs/usr/local/bin/"* /usr/local/bin/
    chmod +x /usr/local/bin/*
    echo " -> Updated /usr/local/bin utilities (calc, periodic, welcome, update, etc.)"
fi

# B. Assets in /usr/local/share/berzelius
if [ -d "$SRC_ROOT/airootfs/usr/local/share/berzelius" ]; then
    mkdir -p /usr/local/share/berzelius
    cp -af "$SRC_ROOT/airootfs/usr/local/share/berzelius/"* /usr/local/share/berzelius/
    echo " -> Updated Berzelius laboratory wallpapers & icons"
fi

# C. OS release & issues
if [ -f "$SRC_ROOT/airootfs/etc/os-release" ]; then
    cp -f "$SRC_ROOT/airootfs/etc/os-release" /etc/os-release
fi
if [ -f "$SRC_ROOT/airootfs/etc/issue" ]; then
    cp -f "$SRC_ROOT/airootfs/etc/issue" /etc/issue
fi
if [ -f "$SRC_ROOT/airootfs/etc/motd" ]; then
    cp -f "$SRC_ROOT/airootfs/etc/motd" /etc/motd
fi

# D. Fastfetch & XDG configurations
if [ -d "$SRC_ROOT/airootfs/etc/fastfetch" ]; then
    mkdir -p /etc/fastfetch
    cp -af "$SRC_ROOT/airootfs/etc/fastfetch/"* /etc/fastfetch/
fi
if [ -d "$SRC_ROOT/airootfs/etc/xdg/fastfetch" ]; then
    mkdir -p /etc/xdg/fastfetch
    cp -af "$SRC_ROOT/airootfs/etc/xdg/fastfetch/"* /etc/xdg/fastfetch/
    echo " -> Updated Fastfetch tall-form beaker branding & configs"
fi

# Step 3: Package upgrades
if [ "$UPDATE_PACKAGES" = true ]; then
    echo -e "${CYAN}[3/3] Synchronizing system package repositories...${NC}"
    if command -v yay >/dev/null 2>&1 && [ -n "${SUDO_USER}" ] && [ "${SUDO_USER}" != "root" ]; then
        echo -e "${GREEN}Detected AUR helper (yay). Updating Arch & AUR packages...${NC}"
        sudo -u "${SUDO_USER}" yay -Syu --noconfirm
    else
        echo -e "${GREEN}Updating Arch Linux core packages via pacman...${NC}"
        pacman -Syu --noconfirm
    fi
else
    echo -e "${YELLOW}[3/3] Skipping pacman package upgrade (--config-only specified).${NC}"
fi

echo ""
echo -e "${GREEN}✨ BerzeliusOS is fully up-to-date!${NC}"
echo ""
if command -v fastfetch >/dev/null 2>&1; then
    fastfetch || true
fi
